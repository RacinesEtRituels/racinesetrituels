# === Serveur & URLs ===
PORT=3000
SITE_URL=https://votre-domaine.vercel.app
API_URL=https://votre-domaine.vercel.app
CURRENCY=eur

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# === Supabase ===
# URL du projet : Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clé publique (frontend) : Dashboard → Project Settings → API → anon / public
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Clé secrète (backend uniquement) : Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REMPLACER

# === Mail (optionnel en prod si SMTP externe) ===
MAIL_HOST=smtp.votre-provider.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_FROM=no-reply@votre-domaine.com

# === Sécurité ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
