# Backend secrets — copier en server/.env et compléter
# Ne jamais committer server/.env (déjà dans .gitignore)
#
# Ce fichier est la documentation complète des variables nécessaires au serveur.
# Certaines proviennent de ../.env.local (SUPABASE_URL, MAIL_*, PORT, SITE_URL…)
# Les secrets ci-dessous sont spécifiques au backend et doivent rester dans server/.env.

# === Supabase local (service role — backend uniquement) ===
# Obtenir depuis : supabase status → service_role key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REMPLACER

# === Stripe (clés test depuis dashboard.stripe.com) ===
STRIPE_SECRET_KEY=sk_test_REMPLACER
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER

# === UUIDs stables pour les FK NOT NULL sur orders ===
# activities.id pour l'activité "Racines & Rituels"
SUPABASE_ACTIVITY_ID=23823b14-7ed5-4ce2-a35d-87d1715ac95a
# channels.id pour le canal "Boutique en ligne"
SUPABASE_CHANNEL_ID=a96d625a-a933-444d-a560-1f6671137028

# ─── Variables héritées de ../.env.local (ne pas dupliquer ici) ───
# PORT=3000
# SITE_URL=http://localhost:5174
# API_URL=http://localhost:3000
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=sb_publishable_...
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SECURE=false
# MAIL_FROM=no-reply@localhost
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
